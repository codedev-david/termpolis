@media print{:root{--bg: #f7f8fa; --surface: #ffffff; --text: #1b2230; --muted: #566073; --line: #e1e5ec; --strong-line: #c9d0dc; --accent: #3550c8; --accent-soft: #eef1fd; --code: #eef1f6; --head: #f3f5f8; --b-inferred: #8a5300; --b-inferred-bg: #fff1d4; --b-verified: #17663a; --b-verified-bg: #ddf4e6; --b-observed: #1c4d9e; --b-observed-bg: #e2ecff; --b-proposed: #6430b5; --b-proposed-bg: #efe7ff; --map-box: #f3f5f9; --map-box-line: #cbd3e0; --map-part: #ffffff; --map-part-line: #b7c2d4; --map-text: #1b2230; --map-muted: #566073; --map-line: #4d63cf; --map-line-text: #2c41a8; --map-count-bg: #ffffff; --map-scroll-shadow: rgba(16, 24, 40, .2);} html{font-size: 16px} body{background: #ffffff; font-size: 10.5pt} .page{display: block; max-width: none; padding: 0} .toc{position: static; break-after: page} .area{break-before: page} #areas{break-before: page} #areas > .area:first-of-type{break-before: auto} .field, figure, tr{break-inside: avoid} h2, h3, h4, h5, .area > p{break-after: avoid} table{font-size: 8.5pt} th, td{padding: 6px 8px} td{min-width: 0} .part{box-shadow: none} .table-wrap, .map{overflow: visible} .lm-map{min-width: 0 !important} p, li, figcaption{max-width: none} thead{display: table-header-group} a{color: inherit; text-decoration: none} *{-webkit-print-color-adjust: exact; print-color-adjust: exact}}
